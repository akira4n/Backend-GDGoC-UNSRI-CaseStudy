# app
NODE_ENV=development
PORT=3000

# database
POSTGRES_DB=gdgoc_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# for dev use @localhost, for prod use @postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gdgoc_db?schema=public"

# jwt
JWT_SECRET="super-secret-key-jsonwebtoken"
JWT_EXPIRES_IN="7d"
